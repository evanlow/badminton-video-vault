# Flask
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# Database (SQLite for local dev)
DATABASE_URL=sqlite:///badminton_vault.db
AUTO_CREATE_DB=true

# AWS
# On EC2, prefer an attached IAM role and omit the two access-key variables.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name

# Playback/download presigned URL expiry (seconds)
PRESIGNED_URL_EXPIRY=3600

# Direct browser-to-S3 multipart upload settings
# 3 GiB maximum video size; Flask itself receives only small JSON requests.
MAX_VIDEO_FILE_SIZE=3221225472
MAX_REQUEST_BODY_SIZE=4194304
S3_MULTIPART_PART_SIZE=16777216
S3_MULTIPART_URL_EXPIRY=7200
S3_MULTIPART_TOKEN_MAX_AGE=21600
S3_MULTIPART_CONCURRENCY=3

# Mailgun HTTP API (not SMTP)
# Use a Mailgun Domain Sending Key where possible.
MAILGUN_API_KEY=your-mailgun-domain-sending-key
MAILGUN_DOMAIN=notifications.tek10x.com
MAILGUN_API_BASE_URL=https://api.mailgun.net
MAIL_FROM="Badminton Video Vault <noreply@notifications.tek10x.com>"
MAIL_SUPPRESS_SEND=true
MAILGUN_TEST_MODE=false
MAILGUN_TIMEOUT_SECONDS=10

# Public base URL used inside password reset and magic login emails.
APP_BASE_URL=http://localhost:5000

# Auth token expiry
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
MAGIC_LOGIN_TOKEN_TTL_MINUTES=15
AUTH_EMAIL_COOLDOWN_SECONDS=60
