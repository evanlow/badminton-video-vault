# Flask
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# Database (SQLite for local dev)
DATABASE_URL=sqlite:///badminton_vault.db

# AWS
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name

# Presigned URL expiry (seconds)
PRESIGNED_URL_EXPIRY=3600

# Mail (used for "forgot password" and "magic link" login emails).
# Example values below use Mailgun's SMTP relay. In Mailgun, create/view
# SMTP credentials under Sending > Domain settings > SMTP credentials
# (these are NOT the same as your Mailgun HTTP API key).
MAIL_SERVER=smtp.mailgun.org
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=postmaster@your-mailgun-domain.com
MAIL_PASSWORD=your-mailgun-smtp-password
MAIL_DEFAULT_SENDER=no-reply@your-mailgun-domain.com
# Set to true to log emails instead of sending them (e.g. local dev without
# mail credentials configured).
MAIL_SUPPRESS_SEND=true
